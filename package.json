{
  "name": "aimani-ai-v2",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @aimani-ai/web dev",
    "build": "pnpm clean:web:build && turbo run build",
    "clean:web:build": "node --eval \"require('node:fs').rmSync('apps/web/dist', { recursive: true, force: true })\"",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "node --env-file=apps/api/.dev.vars --import tsx packages/db/src/migrate.ts",
    "db:demo:reset": "node --env-file=apps/api/.dev.vars --import tsx apps/api/src/dev/reset-demo-database.ts",
    "db:down": "docker compose down",
    "db:seed": "node --env-file=apps/api/.dev.vars --import tsx apps/api/src/dev/seed.ts"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "turbo": "2.10.7",
    "typescript": "7.0.2"
  }
}
